# Synthetic local demo credentials only. Never use these defaults in production.
SUPPLY_DB_HOST=127.0.0.1
SUPPLY_DB_PORT=13306
SUPPLY_DB_NAME=supply_agent
SUPPLY_DB_USER=supply_agent
SUPPLY_DB_PASSWORD=demo-only-db
AGENT_PROVIDER=demo
# Optional real model mode: set AGENT_PROVIDER=deepseek and your own key.
# DEEPSEEK_API_KEY=
# Default local deterministic feature embedding + RRF; fallback: lexical-v3.
RAG_RETRIEVER=hybrid
# Demo only; reset also requires loopback supply_agent and db/06_demo_reset_guard.sql.
# scripts/demo.py supplies these synthetic defaults for the local workbench.
FLOW_DEMO_RESET_ENABLED=true
FLOW_DEMO_RESET_KEY=synthetic-demo-reset-only
