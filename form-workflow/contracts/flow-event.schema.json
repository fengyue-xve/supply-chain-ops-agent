{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://supply-flow.demo/contracts/flow-event.schema.json",
  "title": "FlowEvent",
  "description": "脱敏表单流转事件。POST /api/flow/events 请求体。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "source_record_id",
    "flow_type",
    "business_version",
    "submitted_by"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "pattern": "^evt-[0-9]{3,6}$"
    },
    "source_record_id": {
      "type": "string",
      "pattern": "^R-[0-9]{4}$"
    },
    "flow_type": {
      "enum": ["PRELOAD_OUTER_BOX_MARK"]
    },
    "business_version": {
      "type": "integer",
      "minimum": 1
    },
    "submitted_by": {
      "type": "string",
      "pattern": "^[a-z0-9-]{2,32}$"
    },
    "note": {
      "type": "string",
      "maxLength": 200
    }
  }
}
